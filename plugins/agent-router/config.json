{
  "tiers": {
    "low": "haiku",
    "mid": "sonnet",
    "high": "opus"
  },
  "advisory": {
    "enabled": true
  },
  "routing": {
    "subagents": true
  },
  "rules": {
    "threshold": 0.7,
    "shortChars": 200,
    "longChars": 2000
  },
  "classifier": {
    "enabled": true,
    "model": "haiku",
    "timeoutSeconds": 6
  },
  "log": {
    "maxBytes": 5000000,
    "keepSegments": 3
  },
  "pricing": {
    "haiku": {
      "input": 1.0,
      "output": 5.0,
      "cacheRead": 0.1,
      "cacheWrite": 1.25
    },
    "sonnet": {
      "input": 2.0,
      "output": 10.0,
      "cacheRead": 0.2,
      "cacheWrite": 2.5
    },
    "opus": {
      "input": 5.0,
      "output": 25.0,
      "cacheRead": 0.5,
      "cacheWrite": 6.25
    }
  }
}
