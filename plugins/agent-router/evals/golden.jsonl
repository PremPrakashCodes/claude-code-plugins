# agent-router golden set: subagent dispatches labeled with the tier a good router should pick.
{"id": "low-find-usages", "subagent_type": "Explore", "description": "Find load_config usages", "prompt": "Find every file that imports or calls load_config and list the file paths with line numbers. Do not modify anything.", "expected_tier": "low"}
{"id": "low-list-tests", "subagent_type": "Explore", "description": "List test files", "prompt": "List all test files under tests/ and report how many test cases each one defines.", "expected_tier": "low"}
{"id": "low-summarize-readme", "subagent_type": "general-purpose", "description": "Summarize the README", "prompt": "Read README.md and summarize the installation steps in five bullet points.", "expected_tier": "low"}
{"id": "low-rename-symbol", "subagent_type": "general-purpose", "description": "Rename fetchUser", "prompt": "Rename the function fetchUser to getUser in src/api/users.ts and update its three call sites in the same file.", "expected_tier": "low"}
{"id": "low-fix-typos", "subagent_type": "general-purpose", "description": "Fix typos in docs", "prompt": "Fix the spelling mistakes in docs/CONTRIBUTING.md. Do not change wording otherwise.", "expected_tier": "low"}
{"id": "low-locate-config", "subagent_type": "Explore", "description": "Locate the logging config", "prompt": "Where is the logging level configured? Report the file path and the setting name.", "expected_tier": "low"}
{"id": "low-format-json", "subagent_type": "general-purpose", "description": "Reformat config JSON", "prompt": "Reformat config/settings.json with 2-space indentation and sorted keys. No value changes.", "expected_tier": "low"}
{"id": "mid-add-flag", "subagent_type": "general-purpose", "description": "Add --dry-run flag", "prompt": "Add a --dry-run flag to the deploy command in cli/deploy.py that prints the planned actions without executing them, and add unit tests for both modes.", "expected_tier": "mid"}
{"id": "mid-endpoint", "subagent_type": "general-purpose", "description": "Add saved-searches endpoint", "prompt": "Implement a GET /api/saved-searches endpoint that returns the current user's saved searches from the existing SavedSearch model, following the pattern in api/bookmarks.py, with tests.", "expected_tier": "mid"}
{"id": "mid-fix-clear-bug", "subagent_type": "general-purpose", "description": "Fix off-by-one in pagination", "prompt": "The pagination helper in utils/paginate.py returns one extra item on the last page because the slice end uses <= instead of <. Fix it and add a regression test.", "expected_tier": "mid"}
{"id": "mid-write-tests", "subagent_type": "general-purpose", "description": "Write tests for parser", "prompt": "Write unit tests for src/parser/dates.py covering ISO dates, relative dates like 'next friday', and invalid input. The module is about 150 lines.", "expected_tier": "mid"}
{"id": "mid-update-component", "subagent_type": "general-purpose", "description": "Add loading state to Button", "prompt": "Update the Button component in components/Button.tsx to accept a loading prop that shows a spinner and disables clicks; update its stories and snapshot tests.", "expected_tier": "mid"}
{"id": "mid-migrate-call-sites", "subagent_type": "general-purpose", "description": "Switch to new logger API", "prompt": "Replace the four uses of the deprecated log.warnf helper in services/billing/ with log.warn and structured fields, matching how services/auth/ already does it.", "expected_tier": "mid"}
{"id": "mid-cli-command", "subagent_type": "general-purpose", "description": "Add export command", "prompt": "Add an `export` subcommand to the CLI that writes the current project's tasks to CSV, reusing the existing TaskRepository, and document it in the help text.", "expected_tier": "mid"}
{"id": "high-race", "subagent_type": "general-purpose", "description": "Debug intermittent double-charge", "prompt": "Customers are occasionally charged twice. It only happens under load and we cannot reproduce it locally. Investigate the payment worker, the retry middleware, and the idempotency key handling to find the root cause, then propose a fix.", "expected_tier": "high"}
{"id": "high-architecture", "subagent_type": "Plan", "description": "Design plugin architecture", "prompt": "Design an extension architecture that lets third parties add new storage backends without modifying core code. Compare at least two approaches, describe trade-offs around versioning and isolation, and recommend one.", "expected_tier": "high"}
{"id": "high-security-review", "subagent_type": "general-purpose", "description": "Security review of auth flow", "prompt": "Review the OAuth login flow in auth/ for security vulnerabilities: token handling, redirect validation, CSRF, and session fixation. Report concrete issues with severity.", "expected_tier": "high"}
{"id": "high-perf", "subagent_type": "general-purpose", "description": "Find cause of p99 latency spike", "prompt": "The search API's p99 latency tripled after last week's release while p50 is unchanged. Profile and analyze the query path, caching, and connection pooling to find the cause.", "expected_tier": "high"}
{"id": "high-migration", "subagent_type": "general-purpose", "description": "Plan database migration", "prompt": "Plan the migration of the orders table from a single Postgres instance to a sharded setup with zero downtime, including backfill, dual writes, cutover, and rollback.", "expected_tier": "high"}
{"id": "high-concurrency-refactor", "subagent_type": "general-purpose", "description": "Refactor job scheduler for concurrency", "prompt": "Refactor the job scheduler so multiple instances can run safely at once. Today it assumes a single process and uses in-memory locks; jobs must never run twice and must survive instance crashes.", "expected_tier": "high"}
{"id": "high-deep-review", "subagent_type": "general-purpose", "description": "Review distributed cache design", "prompt": "Review the proposed distributed cache invalidation design in docs/cache-rfc.md for correctness under network partitions and clock skew, and identify failure modes.", "expected_tier": "high"}
